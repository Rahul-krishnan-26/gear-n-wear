# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearnwear

# Admin authentication
ADMIN_PASSWORD=
COOKIE_SECRET=
ADMIN_LOGIN=1

# Seller details for tax invoices. Without these, order tracking offers an order summary.
STORE_GST_STATE=Tamil Nadu
STORE_LEGAL_NAME=
STORE_BILLING_ADDRESS=
STORE_GSTIN=

# Cron endpoint protection
CRON_SECRET=

# Google Apps Script Email Integration (recommended)
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# Optional fallback email provider (Resend)
RESEND_API_KEY=
EMAIL_FROM=GEAR n WEAR <orders@gearandwear.in>
ADMIN_ALERT_EMAIL=ops@gearandwear.in

# Optional SMS provider (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER=GRWEAR

# Optional Razorpay hosted checkout. Use test keys on staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SITE_URL=
